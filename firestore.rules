rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PVGC league app — requires auth (anonymous sign-in is enough)
    match /pvgc/{docId} {
      allow read, write: if request.auth != null;

      match /weekScores/{scoreId} {
        allow read, write: if request.auth != null;
      }

      match /snapshots/{snapId} {
        allow read, write: if request.auth != null;
      }
    }

    // Pocono Open 2026 app
    match /weekends/{docId} {
      // Leaderboard, scatts, winnings are public read
      allow read: if true;
      // Writes require auth (anonymous sign-in is enough)
      allow write: if request.auth != null;

      match /presence/{sessionId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
